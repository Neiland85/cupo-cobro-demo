# Test environment only. Committed on purpose.
# APP_SECRET is a dummy string — not a production credential.
# The Symfony skeleton default ('$ecretf0rt3st') interpolates under some shells.
KERNEL_CLASS='App\Kernel'
APP_SECRET=test-only-not-a-production-secret
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_APP_ENV=panther
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
